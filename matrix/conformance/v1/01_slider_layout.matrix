screen "Controls" {
  header {
    row between {
      text "Agent dashboard"
      toggle "Local only" models.local_only
    }
  }
  col center between {
    row nowrap end around {
      slider "Volume" volume min 0 max 100 step 5 fill
      select "Mode" mode options ["quiet", "normal"]
    }
  }
  footer {
    button "Refresh" primary confirm -> Refresh
  }
}
